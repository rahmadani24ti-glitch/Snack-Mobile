<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- TOOLBAR / BACK BUTTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Login"
                android:textColor="@color/nexora_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Registrasi Akun"
            android:textColor="@color/nexora_dark_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Isi formulir berikut untuk mendaftar akun baru"
            android:textColor="@color/nexora_secondary_text"
            android:textSize="14sp" />

        <!-- FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- NAMA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Lengkap"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="Masukkan nama lengkap"
                android:inputType="textPersonName"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/nexora_dark_text"
                android:textColorHint="@color/nexora_secondary_text"
                android:textSize="14sp" />

            <!-- EMAIL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Email"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="Masukkan email"
                android:inputType="textEmailAddress"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/nexora_dark_text"
                android:textColorHint="@color/nexora_secondary_text"
                android:textSize="14sp" />

            <!-- TANGGAL LAHIR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tanggal Lahir"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTanggalLahir"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="Pilih tanggal lahir (DD/MM/YYYY)"
                android:focusable="false"
                android:clickable="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/nexora_dark_text"
                android:textColorHint="@color/nexora_secondary_text"
                android:textSize="14sp" />

            <!-- JENIS KELAMIN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Jenis Kelamin"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbLaki"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Laki-laki"
                    android:textColor="@color/nexora_dark_text"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbPerempuan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Perempuan"
                    android:textColor="@color/nexora_dark_text"
                    android:textSize="14sp" />

            </RadioGroup>

            <!-- USERNAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Username"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUsernameReg"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="Masukkan username"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/nexora_dark_text"
                android:textColorHint="@color/nexora_secondary_text"
                android:textSize="14sp" />

            <!-- PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Password"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPasswordReg"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="Masukkan password"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/nexora_dark_text"
                android:textColorHint="@color/nexora_secondary_text"
                android:textSize="14sp" />

            <!-- CONFIRM PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Confirm Password"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etConfirmPasswordReg"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_search"
                android:hint="Konfirmasi password"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/nexora_dark_text"
                android:textColorHint="@color/nexora_secondary_text"
                android:textSize="14sp" />

            <!-- TOMBOL SELANJUTNYA -->
            <Button
                android:id="@+id/btnSelanjutnya"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                app:backgroundTint="@null"
                android:text="Selanjutnya"
                android:textAllCaps="false"
                android:textColor="@color/nexora_white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>