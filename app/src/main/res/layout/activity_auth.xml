<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexora_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="50dp"
        android:paddingBottom="40dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="230dp"
            android:layout_height="180dp"
            android:contentDescription="Logo Nexora"
            android:scaleType="fitCenter"
            android:src="@drawable/nexora_logo_full" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Welcome Back!"
            android:textColor="@color/nexora_dark_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sign in to manage your properties"
            android:textColor="@color/nexora_secondary_text"
            android:textSize="14sp" />

        <!-- LOGIN CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_white_card"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- USERNAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:hint="Enter username"
                android:inputType="text"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/nexora_dark_text"
                android:textColorHint="@color/nexora_secondary_text"
                android:textSize="14sp" />

            <!-- PASSWORD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Password"
                android:textColor="@color/nexora_dark_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/nexora_dark_text"
                android:textColorHint="@color/nexora_secondary_text"
                android:textSize="14sp" />

            <!-- LOGIN BUTTON -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_primary_button"
                app:backgroundTint="@null"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="@color/nexora_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- REGISTER BUTTON -->
            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_secondary_button"
                app:backgroundTint="@null"
                android:text="Belum punya akun? Register"
                android:textAllCaps="false"
                android:textColor="@color/nexora_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- INFO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Nexora • Property Management System"
            android:textColor="@color/nexora_secondary_text"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>